<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Interest Chat Dashboard - Your chat conversations">
    <title>Interest Chat - Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-body">
    <div class="dashboard-container">
        <!-- Header -->
        <header class="dashboard-header">
            <h1>Welcome, <span class="welcome-text"><%= username %></span></h1>
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2"></path>
                    <path d="M12 20v2"></path>
                    <path d="m4.93 4.93 1.41 1.41"></path>
                    <path d="m17.66 17.66 1.41 1.41"></path>
                    <path d="M2 12h2"></path>
                    <path d="M20 12h2"></path>
                    <path d="m6.34 17.66-1.41 1.41"></path>
                    <path d="m19.07 4.93-1.41 1.41"></path>
                </svg>
            </button>
        </header>

        <!-- Chat App -->
        <div class="chat-app">
            <!-- People List -->
            <aside class="people-list" id="peopleList">
                <h3>Conversations</h3>
                <input type="text" class="search-input" placeholder="Search contacts...">
                <ul class="chat-list" id="chatList">
                    <!-- Populated by JavaScript -->
                </ul>
            </aside>

            <!-- Chat Panel -->
            <main class="chat-panel">
                <div class="chat-header">
                    <img src="https://ui-avatars.com/api/?name=Chat&background=0ea5e9&color=fff" alt="Chat Avatar">
                    <div class="chat-about">
                        <h4>Select a conversation</h4>
                        <small>Start chatting with your contacts</small>
                    </div>
                </div>

                <div class="chat-history">
                    <ul id="messageList">
                        <li>
                            <div class="message-data">
                                <span class="message-data-time">Welcome!</span>
                            </div>
                            <div class="message my-message">
                                Select a contact from the left to start chatting.
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="chat-message">
                    <form action="/message?token=<%= data['access'] %>" method="POST" id="messageForm">
                        <input 
                            type="text" 
                            name="message" 
                            placeholder="Type your message..." 
                            autocomplete="off"
                            required
                        >
                        <button type="submit">Send</button>
                    </form>
                </div>
            </main>
        </div>
    </div>

    <script>
        // Theme Toggle
        const themeToggle = document.getElementById('themeToggle');
        const body = document.body;

        // Check for saved theme preference
        if (localStorage.getItem('theme') === 'dark') {
            body.classList.add('dark');
        }

        themeToggle.addEventListener('click', () => {
            body.classList.toggle('dark');
            localStorage.setItem('theme', body.classList.contains('dark') ? 'dark' : 'light');
        });

        // Fetch contacts/interests
        const fetchContacts = async () => {
            try {
                const response = await fetch('/interests/received?token=<%= data["access"] %>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                });

                if (response.ok) {
                    const records = await response.json();
                    displayContacts(records);
                }
            } catch (error) {
                console.error('Error fetching contacts:', error);
            }
        };

        // Display contacts in the sidebar
        function displayContacts(records) {
            const chatList = document.getElementById('chatList');
            chatList.innerHTML = '';

            if (records.length === 0) {
                chatList.innerHTML = '<li style="padding: 1rem; color: var(--text-muted); text-align: center;">No contacts yet</li>';
                return;
            }

            records.forEach(record => {
                const li = document.createElement('li');
                li.innerHTML = `
                    <img src="https://ui-avatars.com/api/?name=User${record.sender}&background=0ea5e9&color=fff" alt="User">
                    <div class="user-info">
                        <div class="name">User ${record.sender}</div>
                        <div class="status">${record.status}</div>
                    </div>
                `;
                chatList.appendChild(li);
            });
        }

        // Initialize
        fetchContacts();
    </script>
</body>
</html>
